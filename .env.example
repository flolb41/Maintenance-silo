SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines complètes autorisées en production, séparées par des virgules
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=maintenance
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1

# Envoi réel des e-mails. Exemple Microsoft 365 / Exchange Online.
# Ne jamais versionner EMAIL_HOST_PASSWORD : placez ces valeurs dans .env.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=maintenance@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Maintenance Silo <maintenance@example.com>

MEDIA_ROOT=media
PRIVATE_INVOICE_ROOT=private_invoices
MEDIA_URL=/media/

# Sauvegardes Docker : dossier hôte et durée de conservation (jours)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Taille maximale des fichiers uploadés (en octets), défaut 10 Mo
MAX_UPLOAD_SIZE=10485760
# Nombre maximal de fichiers traités dans un import multiple
MAX_FILES_PER_UPLOAD=20
# Optimisation automatique : images WebP et vidéos WebM/VP9
MEDIA_OPTIMIZATION_ENABLED=True
# Qualité WebP de 1 à 100 ; 90 préserve une qualité visuelle élevée
MEDIA_IMAGE_WEBP_QUALITY=90
# Une valeur vidéo plus basse augmente la qualité et la taille
MEDIA_VIDEO_CRF=28
MEDIA_VIDEO_TIMEOUT=300
FFMPEG_BINARY=ffmpeg
# Extensions autorisées (séparées par virgule)
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,mp4,webm,mov
